#!/usr/bin/env python3
"""
agyhub: Zero-copy Antigravity Customizations Manager
Manage, update, and selectively activate Antigravity skills and plugins in any workspace.
"""

import argparse
import configparser
import datetime
import json
import os
import re
import subprocess
import sys
from pathlib import Path

# Dynamically determine the repository root from the script's physical location:
# bin/agyhub -> parent is bin/ -> parent.parent is skills-hub/
_SCRIPT_DIR = Path(__file__).resolve().parent
_REPO_ROOT = _SCRIPT_DIR.parent if _SCRIPT_DIR.name == "bin" else _SCRIPT_DIR
DEFAULT_HUB_DIR = Path(os.environ.get("AG_HUB_DIR", _REPO_ROOT)).resolve()
GLOBAL_CONFIG_DIR = Path(os.environ.get("AG_GLOBAL_CONFIG_DIR", Path.home() / ".gemini" / "config")).resolve()

# ANSI Color codes for clean output
COLOR_RESET = "\033[0m"
COLOR_BOLD = "\033[1m"
COLOR_GREEN = "\033[32m"
COLOR_CYAN = "\033[36m"
COLOR_YELLOW = "\033[33m"
COLOR_RED = "\033[31m"
COLOR_DIM = "\033[2m"
COLOR_MAGENTA = "\033[35m"

def find_workspace_root(find_root: bool = False) -> Path:
    """Finds the workspace root.
    By default, returns the exact directory where agyhub was executed (Path.cwd().resolve()).
    If find_root is True, searches parent directories for .git or .agents.
    """
    curr = Path.cwd().resolve()
    if find_root:
        for p in [curr] + list(curr.parents):
            if (p / ".git").exists() or (p / ".agents").exists():
                return p
    return curr

def _simple_yaml_parse(content: str) -> dict:
    """Zero-dependency parser for standard cluster YAML files (key-values and lists)."""
    result = {}
    current_list_key = None
    for raw_line in content.splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("- ") and current_list_key:
            item = line[2:].strip().strip("\"'")
            result.setdefault(current_list_key, []).append(item)
            continue
        if ":" in line:
            key, val = line.split(":", 1)
            key = key.strip()
            val = val.strip().strip("\"'")
            if not val:
                current_list_key = key
                result[key] = []
            else:
                current_list_key = None
                result[key] = val
    return result

def _load_cluster_file(file_path: Path) -> dict:
    """Loads a cluster definition from a JSON or YAML file."""
    content = file_path.read_text(encoding="utf-8")
    if file_path.suffix.lower() == ".json":
        return json.loads(content)
    elif file_path.suffix.lower() in (".yaml", ".yml"):
        try:
            import yaml
            return yaml.safe_load(content) or {}
        except ImportError:
            return _simple_yaml_parse(content)
    return {}

def _match_group(filter_group: str, candidate_group: str) -> bool:
    """Matches a group filter against an item's group attribute with alias support (e.g. template <-> templates)."""
    fg = filter_group.lower().strip("/")
    cg = candidate_group.lower().strip("/")

    filter_variants = {fg}
    if fg in ("template", "templates"):
        filter_variants.update(["template", "templates", "internal/template", "internal/templates"])
    elif fg in ("internal/template", "internal/templates"):
        filter_variants.update(["template", "templates", "internal/template", "internal/templates"])

    for var in filter_variants:
        if cg == var or cg.startswith(var + "/") or cg.endswith("/" + var) or f"/{var}/" in cg:
            return True
    return False

def _clean_group_name(raw_group: str) -> str:
    """Normalizes group string to clean name (e.g. internal/hub-tools -> hub-tools, external/agents-cli -> agents-cli)."""
    g = raw_group.strip("/")
    if g.startswith("internal/"):
        g = g[len("internal/"):]
    elif g.startswith("external/"):
        g = g[len("external/"):]
    return g.split("/")[0] if "/" in g else g

def _determine_entry_name(
    parent_dir: Path,
    items_to_add: list[str],
    cluster_context: str | None = None,
    group_context: str | None = None,
    all_catalog: dict | None = None,
    existing_entry: dict | None = None
) -> str:
    """Determines the schema 'name' for a manifest entry based on context, groups, or skill name."""
    if cluster_context:
        return cluster_context
    if group_context:
        return _clean_group_name(group_context)

    catalog = all_catalog or {}
    all_items = set(items_to_add)
    if existing_entry and "include_only" in existing_entry:
        all_items.update(existing_entry.get("include_only") or [])

    if len(all_items) == 1:
        return list(all_items)[0]

    groups = set()
    for item in all_items:
        if item in catalog and "group" in catalog[item]:
            groups.add(_clean_group_name(catalog[item]["group"]))

    if len(groups) == 1:
        return list(groups)[0]

    if existing_entry and existing_entry.get("name"):
        curr_name = existing_entry["name"]
        new_groups = set(_clean_group_name(catalog[item]["group"]) for item in items_to_add if item in catalog and "group" in catalog[item])
        if len(new_groups) <= 1 and (not new_groups or curr_name in new_groups):
            return curr_name

    return "custom"

class ClusterManager:
    def __init__(self, hub_dir: Path = DEFAULT_HUB_DIR, workspace_root: Path | None = None):
        self.hub_dir = hub_dir
        self.workspace_root = workspace_root or find_workspace_root()

    def get_cluster_dirs(self) -> list[Path]:
        """Returns search paths for cluster definitions in priority order."""
        dirs = [
            self.hub_dir / "clusters",
            self.hub_dir / "internal" / "clusters",
            self.workspace_root / ".agents" / "clusters",
        ]
        return dirs

    def load_clusters(self) -> dict[str, dict]:
        """Discovers and parses all cluster definitions."""
        clusters = {}

        # 1. Check single catalog files
        catalog_files = [
            self.hub_dir / "clusters.json",
            self.hub_dir / "clusters.yaml",
            self.hub_dir / "clusters.yml",
            self.workspace_root / ".agents" / "clusters.json",
        ]
        for cat_file in catalog_files:
            if cat_file.exists():
                try:
                    data = _load_cluster_file(cat_file)
                    raw_clusters = data.get("clusters", data) if isinstance(data, dict) else {}
                    for name, info in raw_clusters.items():
                        if isinstance(info, dict):
                            clusters[name] = {
                                "name": name,
                                "description": info.get("description", ""),
                                "skills": list(info.get("skills", [])),
                                "plugins": list(info.get("plugins", [])),
                                "source": str(cat_file)
                            }
                except Exception:
                    pass

        # 2. Check cluster directories for individual definition files
        for c_dir in self.get_cluster_dirs():
            if c_dir.exists() and c_dir.is_dir():
                for item in sorted(c_dir.iterdir()):
                    if item.is_file() and item.suffix.lower() in (".json", ".yaml", ".yml"):
                        try:
                            data = _load_cluster_file(item)
                            if not isinstance(data, dict):
                                continue
                            if "clusters" in data and isinstance(data["clusters"], dict):
                                for c_name, c_info in data["clusters"].items():
                                    clusters[c_name] = {
                                        "name": c_name,
                                        "description": c_info.get("description", ""),
                                        "skills": list(c_info.get("skills", [])),
                                        "plugins": list(c_info.get("plugins", [])),
                                        "source": str(item)
                                    }
                            else:
                                c_name = data.get("name", item.stem)
                                clusters[c_name] = {
                                    "name": c_name,
                                    "description": data.get("description", ""),
                                    "skills": list(data.get("skills", [])),
                                    "plugins": list(data.get("plugins", [])),
                                    "source": str(item)
                                }
                        except Exception:
                            pass

        return clusters

    def get_cluster(self, name: str) -> dict | None:
        clusters = self.load_clusters()
        return clusters.get(name)

    def get_cluster_status(self, cluster_info: dict, active_skills: dict, active_plugins: dict, skill_to_plugin: dict | None = None) -> tuple[int, int, str]:
        """Returns (active_count, total_count, status_label)"""
        skills = cluster_info.get("skills", [])
        plugins = cluster_info.get("plugins", [])
        total = len(skills) + len(plugins)
        if total == 0:
            return 0, 0, "EMPTY"

        active_skills_count = 0
        for s in skills:
            if s in active_skills:
                active_skills_count += 1
            elif skill_to_plugin and skill_to_plugin.get(s) in active_plugins:
                active_skills_count += 1

        active_plugins_count = sum(1 for p in plugins if p in active_plugins)
        active = active_skills_count + active_plugins_count

        if active == total:
            status = "ACTIVE"
        elif active > 0:
            status = "PARTIAL"
        else:
            status = "INACTIVE"
        return active, total, status


def get_skill_description(skill_dir: Path) -> str:
    """Extracts description from SKILL.md YAML frontmatter."""
    skill_file = skill_dir / "SKILL.md"
    if not skill_file.exists():
        return ""
    try:
        content = skill_file.read_text(encoding="utf-8", errors="replace")
        match = re.search(r"^---\s*\n(.*?)\n---", content, re.DOTALL)
        if match:
            fm = match.group(1)
            desc_match = re.search(r"description:\s*(?:>-|>|\|)?\s*(.+?)(?=\n[a-zA-Z_-]+:|\Z)", fm, re.DOTALL)
            if desc_match:
                desc = desc_match.group(1).replace("\n", " ").strip()
                desc = re.sub(r"\s+", " ", desc)
                return desc[:85] + ("..." if len(desc) > 85 else "")
    except Exception:
        pass
    return ""

def get_plugin_description(plugin_dir: Path) -> str:
    """Extracts description from plugin.json."""
    manifest = plugin_dir / "plugin.json"
    if not manifest.exists():
        return ""
    try:
        data = json.loads(manifest.read_text(encoding="utf-8"))
        desc = data.get("description", "")
        if desc:
            return desc[:85] + ("..." if len(desc) > 85 else "")
    except Exception:
        pass
    return ""

class HubManager:
    def __init__(self, hub_dir: Path = DEFAULT_HUB_DIR):
        self.hub_dir = hub_dir

    def get_submodules(self) -> dict[str, dict]:
        """Reads .gitmodules from hub_dir to find registered repositories."""
        modules = {}
        gitmodules_file = self.hub_dir / ".gitmodules"
        if not gitmodules_file.exists():
            return modules

        config = configparser.ConfigParser()
        try:
            config.read(gitmodules_file)
            for section in config.sections():
                path = config.get(section, "path", fallback="")
                url = config.get(section, "url", fallback="")
                branch = config.get(section, "branch", fallback="main")
                if path:
                    name = Path(path).name
                    modules[name] = {
                        "path": self.hub_dir / path,
                        "url": url,
                        "branch": branch
                    }
        except Exception:
            pass
        return modules

    def get_plugin_skills_map(self, skills: dict | None = None, plugins: dict | None = None):
        """Builds bidirectional mappings: skill_to_plugin and plugin_to_skills."""
        if skills is None or plugins is None:
            skills, plugins = self.get_available()

        # Sort plugins by path depth descending so most specific (deepest) match first
        sorted_plugins = sorted(
            plugins.items(),
            key=lambda item: len(str(item[1]["path"].resolve())),
            reverse=True
        )

        skill_to_plugin = {}
        plugin_to_skills = {p: [] for p in plugins}

        for s_name, s_info in skills.items():
            s_path = s_info["path"].resolve()
            for p_name, p_info in sorted_plugins:
                p_path = p_info["path"].resolve()
                try:
                    s_path.relative_to(p_path)
                    skill_to_plugin[s_name] = p_name
                    plugin_to_skills[p_name].append(s_name)
                    break
                except ValueError:
                    continue

        return skill_to_plugin, plugin_to_skills

    def get_available(self):
        """Discovers all skills and plugins across standalone folders and submodules."""
        skills = {}    # name -> {path, parent, desc, group}
        plugins = {}   # name -> {path, parent, desc, group}

        # 1. Internal typology directories in internal/ (e.g. internal/templates/, internal/hub-tools/)
        internal_dir = self.hub_dir / "internal"
        if internal_dir.exists():
            reserved_internal = {"clusters", ".git"}
            for grp_dir in sorted(internal_dir.iterdir()):
                if grp_dir.is_dir() and grp_dir.name not in reserved_internal and not grp_dir.name.startswith("."):
                    grp_name = grp_dir.name
                    # Check if there is a skills/ subfolder inside internal/<grp>/skills/
                    sub_skills_dir = grp_dir / "skills"
                    if sub_skills_dir.exists():
                        for item in sorted(sub_skills_dir.iterdir()):
                            if item.is_dir() and (item / "SKILL.md").exists() and item.name not in skills:
                                skills[item.name] = {
                                    "path": item,
                                    "parent": item.parent,
                                    "desc": get_skill_description(item),
                                    "group": f"internal/{grp_name}"
                                }
                    # Check direct skills inside internal/<grp>/<skill>/SKILL.md (backward-compat fallback)
                    for item in sorted(grp_dir.iterdir()):
                        if item.is_dir() and item.name not in ("skills", "plugins", "rules") and (item / "SKILL.md").exists() and item.name not in skills:
                            skills[item.name] = {
                                "path": item,
                                "parent": item.parent,
                                "desc": get_skill_description(item),
                                "group": f"internal/{grp_name}"
                            }
                    # Check if there is a plugins/ subfolder inside internal/<grp>/plugins/
                    sub_plugins_dir = grp_dir / "plugins"
                    if sub_plugins_dir.exists():
                        for item in sorted(sub_plugins_dir.iterdir()):
                            if item.is_dir() and (item / "plugin.json").exists() and item.name not in plugins:
                                plugins[item.name] = {
                                    "path": item,
                                    "parent": item.parent,
                                    "desc": get_plugin_description(item),
                                    "group": f"internal/{grp_name}"
                                }

        # 2. Legacy fallback: root skills/ or internal/skills/ if present
        for s_dir in [self.hub_dir / "internal" / "skills", self.hub_dir / "skills"]:
            if s_dir.exists():
                for d in sorted(s_dir.iterdir()):
                    if d.is_dir():
                        if (d / "SKILL.md").exists() and d.name not in skills:
                            skills[d.name] = {
                                "path": d,
                                "parent": d.parent,
                                "desc": get_skill_description(d),
                                "group": "internal/skills"
                            }
                        else:
                            # Subcategorized under internal/skills/<category>/<skill>
                            for sub in sorted(d.iterdir()):
                                if sub.is_dir() and (sub / "SKILL.md").exists() and sub.name not in skills:
                                    skills[sub.name] = {
                                        "path": sub,
                                        "parent": sub.parent,
                                        "desc": get_skill_description(sub),
                                        "group": f"internal/{d.name}"
                                    }

        # 3. Legacy fallback: root plugins/ or internal/plugins/ if present
        for p_dir in [self.hub_dir / "internal" / "plugins", self.hub_dir / "plugins"]:
            if p_dir.exists():
                for d in sorted(p_dir.iterdir()):
                    if d.is_dir() and (d / "plugin.json").exists() and d.name not in plugins:
                        plugins[d.name] = {
                            "path": d,
                            "parent": d.parent,
                            "desc": get_plugin_description(d),
                            "group": "internal/plugins"
                        }

        # 4. Submodules (external/ and registered in .gitmodules)
        submodules = self.get_submodules()
        for sub_name, sub_info in submodules.items():
            sub_path = sub_info["path"]
            if not sub_path.exists():
                continue

            group_prefix = f"external/{sub_name}"

            # Check root plugin.json in submodule
            if (sub_path / "plugin.json").exists():
                plugins[sub_name] = {
                    "path": sub_path,
                    "parent": sub_path.parent,
                    "desc": get_plugin_description(sub_path),
                    "group": group_prefix
                }

            # Check plugins/ subdirectory in submodule (recursive discovery)
            sub_plugins_dir = sub_path / "plugins"
            if sub_plugins_dir.exists():
                for plugin_file in sorted(sub_plugins_dir.glob("**/plugin.json")):
                    rel = plugin_file.relative_to(sub_plugins_dir)
                    # Skip hidden dirs and third-party manifests (.claude-plugin, .codex-plugin, etc.)
                    if any(part.startswith(".") for part in rel.parts):
                        continue
                    p_dir = plugin_file.parent
                    if p_dir.name in ("plugin", "plugins"):
                        p_name = p_dir.parent.name
                        rel_parent = p_dir.parent.parent.relative_to(sub_plugins_dir)
                    else:
                        p_name = p_dir.name
                        rel_parent = p_dir.parent.relative_to(sub_plugins_dir)

                    if p_name not in plugins:
                        if str(rel_parent) != ".":
                            p_group = f"{group_prefix}/{rel_parent}"
                        else:
                            p_group = group_prefix
                        plugins[p_name] = {
                            "path": p_dir,
                            "parent": p_dir.parent,
                            "desc": get_plugin_description(p_dir),
                            "group": p_group
                        }

            # Check skills/ subdirectory in submodule
            sub_skills_dir = sub_path / "skills"
            if sub_skills_dir.exists():
                for item in sorted(sub_skills_dir.iterdir()):
                    if item.is_dir():
                        if (item / "SKILL.md").exists():
                            # Direct skill
                            skills[item.name] = {
                                "path": item,
                                "parent": item.parent,
                                "desc": get_skill_description(item),
                                "group": group_prefix
                            }
                        else:
                            # Subcategorized (e.g. cloud/, ads/, analytics/)
                            for subitem in sorted(item.iterdir()):
                                if subitem.is_dir() and (subitem / "SKILL.md").exists():
                                    skills[subitem.name] = {
                                        "path": subitem,
                                        "parent": subitem.parent,
                                        "desc": get_skill_description(subitem),
                                        "group": f"{group_prefix}/{item.name}"
                                    }

        return skills, plugins

    def get_target_dirs(self, workspace_root: Path | None = None, is_global: bool = False):
        """Returns (config_dir, skills_manifest, plugins_manifest, skills_symlinks_dir, plugins_symlinks_dir, scope_label)"""
        if is_global:
            GLOBAL_CONFIG_DIR.mkdir(parents=True, exist_ok=True)
            return (
                GLOBAL_CONFIG_DIR,
                GLOBAL_CONFIG_DIR / "skills.json",
                GLOBAL_CONFIG_DIR / "plugins.json",
                GLOBAL_CONFIG_DIR / "skills",
                GLOBAL_CONFIG_DIR / "plugins",
                "GLOBAL (~/.gemini/config)",
            )
        else:
            ws = workspace_root or find_workspace_root()
            agents_dir = ws / ".agents"
            agents_dir.mkdir(parents=True, exist_ok=True)
            return (
                agents_dir,
                agents_dir / "skills.json",
                agents_dir / "plugins.json",
                agents_dir / "skills",
                agents_dir / "plugins",
                f"WORKSPACE ({ws})",
            )

    def get_active(self, workspace_root: Path | None = None, is_global: bool = False):
        """Detects active skills and plugins in target scope (workspace or global)."""
        active_skills = {}   # name -> mode ("manifest" or "symlink")
        active_plugins = {}  # name -> mode

        _, skills_json_path, plugins_json_path, skills_dir, plugins_dir, _ = self.get_target_dirs(workspace_root, is_global)

        # 1. Check manifests
        if skills_json_path.exists():
            try:
                data = json.loads(skills_json_path.read_text(encoding="utf-8"))
                for entry in data.get("entries", []):
                    entry_path = str(Path(entry.get("path", "")).resolve())
                    include_only = entry.get("include_only")
                    if include_only is not None:
                        for s in include_only:
                            active_skills[s] = "manifest"
                    else:
                        ep = Path(entry_path)
                        if ep.exists():
                            for child in ep.iterdir():
                                if child.is_dir():
                                    active_skills[child.name] = "manifest"
            except Exception:
                pass

        if plugins_json_path.exists():
            try:
                data = json.loads(plugins_json_path.read_text(encoding="utf-8"))
                for entry in data.get("entries", []):
                    entry_path = str(Path(entry.get("path", "")).resolve())
                    include_only = entry.get("include_only")
                    if include_only is not None:
                        for p in include_only:
                            active_plugins[p] = "manifest"
                    else:
                        ep = Path(entry_path)
                        if ep.exists():
                            for child in ep.iterdir():
                                if child.is_dir():
                                    active_plugins[child.name] = "manifest"
            except Exception:
                pass

        # 2. Check symlinks
        if skills_dir.exists():
            for child in skills_dir.iterdir():
                if child.is_symlink() or child.is_dir():
                    active_skills[child.name] = "symlink"

        if plugins_dir.exists():
            for child in plugins_dir.iterdir():
                if child.is_symlink() or child.is_dir():
                    active_plugins[child.name] = "symlink"

        return active_skills, active_plugins

    def get_workspace_active(self, workspace_root: Path):
        """Detects active customizations in workspace."""
        return self.get_active(workspace_root=workspace_root, is_global=False)

    def get_global_active(self):
        """Detects active customizations in machine-wide global scope (~/.gemini/config)."""
        return self.get_active(is_global=True)

    def enable(self, workspace_root: Path | None = None, names: list[str] | None = None, group: str | None = None, clusters: list[str] | None = None, as_symlink: bool = False, is_global: bool = False, configure_permissions: bool = True):
        all_skills, all_plugins = self.get_available()
        target_dir, skills_json, plugins_json, skills_dir, plugins_dir, scope_label = self.get_target_dirs(workspace_root, is_global)

        target_names = list(names or [])
        cluster_context = clusters[0] if (clusters and len(clusters) == 1) else None
        group_context = group if group else None

        if clusters:
            cm = ClusterManager(hub_dir=self.hub_dir, workspace_root=workspace_root)
            all_clusters = cm.load_clusters()
            for c_name in clusters:
                if c_name in all_clusters:
                    c_info = all_clusters[c_name]
                    c_skills = c_info.get("skills", [])
                    c_plugins = c_info.get("plugins", [])
                    target_names.extend(c_skills)
                    target_names.extend(c_plugins)
                    print(f"{COLOR_CYAN}Applying cluster '{COLOR_BOLD}{c_name}{COLOR_RESET}{COLOR_CYAN}' ({len(c_skills)} skills, {len(c_plugins)} plugins)...{COLOR_RESET}")
                else:
                    print(f"{COLOR_RED}Unknown cluster:{COLOR_RESET} '{c_name}'. Run 'agyhub cluster list' to view available clusters.")

        if group:
            matching_skills = [
                s for s, info in all_skills.items()
                if _match_group(group, info["group"])
            ]
            matching_plugins = [
                p for p, info in all_plugins.items()
                if _match_group(group, info["group"])
            ]
            if matching_skills or matching_plugins:
                target_names.extend(matching_skills)
                target_names.extend(matching_plugins)
            else:
                print(f"{COLOR_YELLOW}No skills or plugins found in group '{group}'.{COLOR_RESET}")

        if not target_names:
            print("No skills, plugins, or clusters specified to enable.")
            return

        scope_tag = f" {COLOR_MAGENTA}[GLOBAL]{COLOR_RESET}" if is_global else ""
        manifest_rel = "~/.gemini/config/" if is_global else ".agents/"

        active_skills, active_plugins = self.get_active(workspace_root=workspace_root, is_global=is_global)
        skill_to_plugin, plugin_to_skills = self.get_plugin_skills_map(skills=all_skills, plugins=all_plugins)

        target_skills = []
        target_plugins = []
        for name in target_names:
            if name in all_plugins:
                if name not in target_plugins:
                    target_plugins.append(name)
            elif name in all_skills:
                if name not in target_skills:
                    target_skills.append(name)
            else:
                print(f"{COLOR_RED}✗ Unknown skill or plugin:{COLOR_RESET} '{name}'")

        if not target_skills and not target_plugins:
            print("No valid skills or plugins found to enable.")
            return

        effective_active_plugins = set(active_plugins.keys()) | set(target_plugins)
        enabled_count = 0

        # 1. Enable plugins first
        for p_name in target_plugins:
            item_info = all_plugins[p_name]
            src_path = item_info["path"]
            parent_dir = item_info["parent"]

            if as_symlink:
                plugins_dir.mkdir(parents=True, exist_ok=True)
                link_path = plugins_dir / p_name
                if link_path.exists() or link_path.is_symlink():
                    link_path.unlink()
                link_path.symlink_to(src_path)
                print(f"{COLOR_GREEN}✓{COLOR_RESET} Symlinked plugin '{COLOR_BOLD}{p_name}{COLOR_RESET}' -> {link_path}{scope_tag}")
            else:
                self._update_manifest(
                    plugins_json,
                    parent_dir,
                    p_name,
                    add=True,
                    cluster_context=cluster_context,
                    group_context=group_context,
                    all_catalog=all_plugins
                )
                print(f"{COLOR_GREEN}✓{COLOR_RESET} Enabled plugin '{COLOR_BOLD}{p_name}{COLOR_RESET}' [{item_info['group']}] in {manifest_rel}plugins.json{scope_tag}")
            enabled_count += 1

            # Prune any bundled skills of this plugin that were already active as individual entries
            bundled = plugin_to_skills.get(p_name, [])
            for s_bundled in bundled:
                if s_bundled in active_skills:
                    if as_symlink:
                        link_path = skills_dir / s_bundled
                        if link_path.exists() or link_path.is_symlink():
                            link_path.unlink()
                    else:
                        self._update_manifest(skills_json, None, s_bundled, add=False, all_catalog=all_skills)
                    print(f"{COLOR_DIM}  Pruned duplicate individual skill '{s_bundled}' (now covered by plugin '{p_name}'){COLOR_RESET}")

        # 2. Filter target skills covered by active/enabled plugins
        skills_to_enable = []
        for s_name in target_skills:
            parent_plug = skill_to_plugin.get(s_name)
            if parent_plug and parent_plug in effective_active_plugins:
                print(f"{COLOR_DIM}  Skill '{s_name}' is automatically provided by active plugin '{parent_plug}' (skipped duplicate mount){COLOR_RESET}")
                enabled_count += 1
            else:
                skills_to_enable.append(s_name)

        if as_symlink:
            for s_name in skills_to_enable:
                item_info = all_skills[s_name]
                src_path = item_info["path"]
                skills_dir.mkdir(parents=True, exist_ok=True)
                link_path = skills_dir / s_name
                if link_path.exists() or link_path.is_symlink():
                    link_path.unlink()
                link_path.symlink_to(src_path)
                print(f"{COLOR_GREEN}✓{COLOR_RESET} Symlinked skill '{COLOR_BOLD}{s_name}{COLOR_RESET}' -> {link_path}{scope_tag}")
                enabled_count += 1
        else:
            by_parent = {}
            for s_name in skills_to_enable:
                p_dir = all_skills[s_name]["parent"]
                by_parent.setdefault(p_dir, []).append(s_name)

            for p_dir, s_names in by_parent.items():
                self._update_manifest(
                    skills_json,
                    p_dir,
                    s_names,
                    add=True,
                    cluster_context=cluster_context,
                    group_context=group_context,
                    all_catalog=all_skills
                )
                for s_name in s_names:
                    grp = all_skills[s_name]["group"]
                    print(f"{COLOR_GREEN}✓{COLOR_RESET} Enabled skill '{COLOR_BOLD}{s_name}{COLOR_RESET}' [{grp}] in {manifest_rel}skills.json{scope_tag}")
                    enabled_count += 1
        ws = workspace_root or find_workspace_root()
        if configure_permissions and enabled_count > 0 and (is_global or ws.resolve() != self.hub_dir.resolve()):
            print(f"\n{COLOR_CYAN}💡 Note on Non-Workspace File Reads:{COLOR_RESET}")
            print(f"   Zero-copy customizations reference files located in:")
            print(f"   {COLOR_BOLD}{self.hub_dir.resolve()}{COLOR_RESET}")
            print(f"   If your AI tool or editor (Antigravity, Cursor, etc.) restricts non-workspace reads,")
            print(f"   ensure this directory is added to your tool's allowed \"File Reads\" / trusted paths:")
            print(f"   • Antigravity IDE: Settings → Permissions → File Permissions → Add File Read")

    def disable(self, workspace_root: Path | None = None, names: list[str] | None = None, group: str | None = None, clusters: list[str] | None = None, disable_all: bool = False, is_global: bool = False, clean_permissions: bool = False):
        all_skills, all_plugins = self.get_available()
        target_dir, skills_json, plugins_json, skills_dir, plugins_dir, scope_label = self.get_target_dirs(workspace_root, is_global)

        target_names = list(names or [])
        scope_str = "global scope (~/.gemini/config)" if is_global else "this workspace"
        manifest_rel = "~/.gemini/config/" if is_global else ".agents/"

        if clusters:
            cm = ClusterManager(hub_dir=self.hub_dir, workspace_root=workspace_root)
            all_clusters = cm.load_clusters()
            for c_name in clusters:
                if c_name in all_clusters:
                    c_info = all_clusters[c_name]
                    c_skills = c_info.get("skills", [])
                    c_plugins = c_info.get("plugins", [])
                    target_names.extend(c_skills)
                    target_names.extend(c_plugins)
                    print(f"{COLOR_CYAN}Deactivating cluster '{COLOR_BOLD}{c_name}{COLOR_RESET}{COLOR_CYAN}'...{COLOR_RESET}")
                else:
                    print(f"{COLOR_RED}Unknown cluster:{COLOR_RESET} '{c_name}'.")

        if disable_all:
            active_skills, active_plugins = self.get_active(workspace_root, is_global=is_global)
            if is_global:
                # In global mode, only target hub-managed items to preserve external system plugins
                target_names = [s for s in active_skills if s in all_skills] + [p for p in active_plugins if p in all_plugins]
            else:
                target_names = list(set(list(active_skills.keys()) + list(active_plugins.keys())))
            if not target_names:
                print(f"{COLOR_YELLOW}No hub customizations currently active in {scope_str}.{COLOR_RESET}")
                return
        elif group:
            matching = [
                s for s, info in all_skills.items()
                if _match_group(group, info["group"])
            ] + [
                p for p, info in all_plugins.items()
                if _match_group(group, info["group"])
            ]
            if matching:
                target_names.extend(matching)

        if not target_names:
            print(f"No skills or plugins specified to disable. Use --all to disable everything in {scope_str}.")
            return

        for name in target_names:
            removed = False
            if skills_json.exists():
                if self._update_manifest(skills_json, None, name, add=False, all_catalog=all_skills):
                    print(f"{COLOR_YELLOW}Removed{COLOR_RESET} skill '{name}' from {manifest_rel}skills.json")
                    removed = True

            if plugins_json.exists():
                if self._update_manifest(plugins_json, None, name, add=False, all_catalog=all_plugins):
                    print(f"{COLOR_YELLOW}Removed{COLOR_RESET} plugin '{name}' from {manifest_rel}plugins.json")
                    removed = True

            skill_symlink = skills_dir / name
            if skill_symlink.exists() or skill_symlink.is_symlink():
                # In global mode, only unlink symlinks pointing into this hub
                if not is_global or (skill_symlink.is_symlink() and str(skill_symlink.resolve()).startswith(str(self.hub_dir))):
                    skill_symlink.unlink()
                    print(f"{COLOR_YELLOW}Removed{COLOR_RESET} symlink {skill_symlink}")
                    removed = True

            plugin_symlink = plugins_dir / name
            if plugin_symlink.exists() or plugin_symlink.is_symlink():
                # In global mode, only unlink symlinks pointing into this hub
                if not is_global or (plugin_symlink.is_symlink() and str(plugin_symlink.resolve()).startswith(str(self.hub_dir))):
                    plugin_symlink.unlink()
                    print(f"{COLOR_YELLOW}Removed{COLOR_RESET} symlink {plugin_symlink}")
                    removed = True

            if not removed and not group and not clusters:
                print(f"{COLOR_DIM}Item '{name}' was not active in {scope_str}.{COLOR_RESET}")

        if clean_permissions:
            # Deprecated no-op: agyhub leaves tool permissions to the user's IDE/editor settings.
            pass

    def _update_manifest(
        self,
        manifest_file: Path,
        parent_dir: Path | None,
        item_name: str | list[str],
        add: bool = True,
        cluster_context: str | None = None,
        group_context: str | None = None,
        all_catalog: dict | None = None
    ) -> bool:
        """Updates or removes items in skills.json or plugins.json, maintaining name and date schema."""
        data = {"entries": []}
        if manifest_file.exists():
            try:
                data = json.loads(manifest_file.read_text(encoding="utf-8"))
            except Exception:
                data = {"entries": []}

        entries = data.get("entries", [])
        modified = False
        items = [item_name] if isinstance(item_name, str) else list(item_name)

        if add and parent_dir is not None:
            resolved_parent = str(parent_dir.resolve())
            entry_index = None
            for idx, e in enumerate(entries):
                if str(Path(e.get("path", "")).resolve()) == resolved_parent:
                    entry_index = idx
                    break

            if entry_index is not None:
                entry_match = entries[entry_index]
                inc = list(entry_match.get("include_only") or [])
                items_added = False
                for itm in items:
                    if itm not in inc:
                        inc.append(itm)
                        items_added = True
                if items_added:
                    inc.sort()
                    modified = True

                entry_name = _determine_entry_name(
                    parent_dir=parent_dir,
                    items_to_add=items,
                    cluster_context=cluster_context,
                    group_context=group_context,
                    all_catalog=all_catalog,
                    existing_entry=entry_match
                )
                entry_date = entry_match.get("date") or datetime.date.today().isoformat()

                if entry_match.get("name") != entry_name or entry_match.get("date") != entry_date:
                    modified = True

                new_entry = {
                    "name": entry_name,
                    "date": entry_date,
                    "path": entry_match.get("path", resolved_parent),
                    "include_only": inc
                }
                entries[entry_index] = new_entry
            else:
                entry_name = _determine_entry_name(
                    parent_dir=parent_dir,
                    items_to_add=items,
                    cluster_context=cluster_context,
                    group_context=group_context,
                    all_catalog=all_catalog
                )
                entry_date = datetime.date.today().isoformat()
                entries.append({
                    "name": entry_name,
                    "date": entry_date,
                    "path": resolved_parent,
                    "include_only": sorted(list(set(items)))
                })
                modified = True
            data["entries"] = entries

        elif not add:
            items_to_remove = set(items)
            new_entries = []
            for e in entries:
                inc = e.get("include_only")
                if inc is not None:
                    orig_len = len(inc)
                    new_inc = [x for x in inc if x not in items_to_remove]
                    if len(new_inc) != orig_len:
                        modified = True
                    if len(new_inc) > 0:
                        e_name = e.get("name") or _determine_entry_name(Path(e.get("path", "")), new_inc, all_catalog=all_catalog)
                        e_date = e.get("date") or datetime.date.today().isoformat()
                        new_e = {
                            "name": e_name,
                            "date": e_date,
                            "path": e.get("path", ""),
                            "include_only": sorted(new_inc)
                        }
                        new_entries.append(new_e)
                else:
                    new_entries.append(e)
            data["entries"] = new_entries

        if modified:
            if not data["entries"]:
                if manifest_file.exists():
                    manifest_file.unlink()
            else:
                manifest_file.parent.mkdir(parents=True, exist_ok=True)
                manifest_file.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
        return modified
    def _grant_read_permissions(self, paths: list[Path] | None = None) -> list[str]:
        """Deprecated: retained for backward compatibility."""
        return []

    def _revoke_read_permissions(self, paths: list[Path] | None = None) -> list[str]:
        """Deprecated: retained for backward compatibility."""
        return []

    def update_repos(self, targets: list[str] | None = None, check_only: bool = False):
        """Fetches and pulls upstream updates for git submodules."""
        submodules = self.get_submodules()
        if not submodules:
            print("No submodules found in .gitmodules.")
            return

        selected = {}
        if targets:
            for t in targets:
                clean_t = t.rstrip("/").split("/")[-1]
                if clean_t in submodules:
                    selected[clean_t] = submodules[clean_t]
                elif t in submodules:
                    selected[t] = submodules[t]
                else:
                    print(f"{COLOR_RED}Unknown repository:{COLOR_RESET} '{t}'. Available: {', '.join(submodules.keys())}")
        else:
            selected = submodules

        print(f"\n{COLOR_BOLD}{'Checking' if check_only else 'Updating'} Git Submodules in {self.hub_dir}...{COLOR_RESET}\n")

        for name, info in selected.items():
            path = info["path"]
            branch = info["branch"]
            url = info["url"]

            if not path.exists():
                print(f"Initializing {name} ({url})...")
                subprocess.run(["git", "submodule", "update", "--init", "--recursive", str(path.relative_to(self.hub_dir))],
                               cwd=self.hub_dir, check=False)

            # Get current commit
            res_curr = subprocess.run(["git", "rev-parse", "HEAD"], cwd=path, capture_output=True, text=True)
            curr_hash = res_curr.stdout.strip()[:8]

            # Fetch upstream
            fetch_res = subprocess.run(["git", "fetch", "origin", branch], cwd=path, capture_output=True, text=True)
            if fetch_res.returncode != 0:
                print(f"{COLOR_RED}✗ [{name}]{COLOR_RESET} Failed to fetch from {url} ({branch})")
                continue

            # Get remote commit
            res_remote = subprocess.run(["git", "rev-parse", f"origin/{branch}"], cwd=path, capture_output=True, text=True)
            remote_hash = res_remote.stdout.strip()[:8]

            if curr_hash == remote_hash:
                print(f"  {COLOR_GREEN}✓{COLOR_RESET} {COLOR_BOLD}{name:<18}{COLOR_RESET} Up to date ({curr_hash} on {branch})")
            else:
                # Count commits behind
                res_count = subprocess.run(["git", "rev-list", "--count", f"HEAD..origin/{branch}"],
                                           cwd=path, capture_output=True, text=True)
                count = res_count.stdout.strip()

                if check_only:
                    print(f"  {COLOR_YELLOW}!{COLOR_RESET} {COLOR_BOLD}{name:<18}{COLOR_RESET} Update available: {curr_hash} -> {remote_hash} ({count} new commit{'s' if count != '1' else ''})")
                else:
                    merge_res = subprocess.run(["git", "merge", "--ff-only", f"origin/{branch}"],
                                               cwd=path, capture_output=True, text=True)
                    if merge_res.returncode == 0:
                        print(f"  {COLOR_GREEN}✓{COLOR_RESET} {COLOR_BOLD}{name:<18}{COLOR_RESET} Updated: {curr_hash} -> {remote_hash} ({count} new commit{'s' if count != '1' else ''})")
                        # Stage updated commit pointer in hub repo
                        subprocess.run(["git", "add", str(path.relative_to(self.hub_dir))], cwd=self.hub_dir)
                    else:
                        print(f"  {COLOR_RED}✗{COLOR_RESET} {COLOR_BOLD}{name:<18}{COLOR_RESET} Merge conflict or error: {merge_res.stderr.strip()}")

        print()

    def scaffold(self, item_type: str, name: str, group: str | None = None, is_local: bool = False, workspace_root: Path | None = None):
        clean_group = "templates"
        if group:
            clean_group = group.strip("/")
            if clean_group.startswith("internal/"):
                clean_group = clean_group[len("internal/"):]

        if item_type == "skill":
            if is_local:
                target = (workspace_root or find_workspace_root()) / ".agents" / "skills" / name
                target_scope = "workspace (.agents/skills)"
            else:
                target = self.hub_dir / "internal" / clean_group / "skills" / name
                target_scope = f"hub (internal/{clean_group}/skills)"
            if target.exists():
                print(f"{COLOR_RED}Error:{COLOR_RESET} Skill '{name}' already exists at {target}")
                return
            target.mkdir(parents=True, exist_ok=True)
            skill_md = target / "SKILL.md"
            skill_md.write_text(f"""---
name: {name}
description: Describe what {name} does and when the agent should activate it.
---

# {name.replace('-', ' ').title()}

## When to Use This Skill
- 

## Workflow
1. 
""", encoding="utf-8")
            print(f"{COLOR_GREEN}✓{COLOR_RESET} Created new {target_scope} skill '{COLOR_BOLD}{name}{COLOR_RESET}' at {target}")

        elif item_type == "plugin":
            target = self.hub_dir / "internal" / clean_group / "plugins" / name
            if target.exists():
                print(f"{COLOR_RED}Error:{COLOR_RESET} Plugin '{name}' already exists at {target}")
                return
            target.mkdir(parents=True, exist_ok=True)
            (target / "skills").mkdir(parents=True, exist_ok=True)
            (target / "rules").mkdir(parents=True, exist_ok=True)
            manifest = target / "plugin.json"
            manifest.write_text(json.dumps({
                "name": name,
                "description": f"Description for {name}"
            }, indent=2) + "\n", encoding="utf-8")
            print(f"{COLOR_GREEN}✓{COLOR_RESET} Created new plugin '{COLOR_BOLD}{name}{COLOR_RESET}' at {target}")

        elif item_type == "rule":
            target_dir = self.hub_dir / "internal" / clean_group / "rules"
            target_dir.mkdir(parents=True, exist_ok=True)
            rule_file = name if name.endswith(".md") else f"{name}.md"
            target = target_dir / rule_file
            if target.exists():
                print(f"{COLOR_RED}Error:{COLOR_RESET} Rule '{rule_file}' already exists at {target}")
                return
            rule_title = name[:-3] if name.endswith(".md") else name
            target.write_text(f"""# {rule_title.replace('-', ' ').title()} Guidelines

Guidelines and coding standards for {rule_title}.

## Principles
- Prefer simple, readable, and maintainable solutions.
- Follow established project architecture and testing standards.
""", encoding="utf-8")
            print(f"{COLOR_GREEN}✓{COLOR_RESET} Created new rule '{COLOR_BOLD}{rule_file}{COLOR_RESET}' at {target}")

        elif item_type == "cluster":
            if is_local:
                target_dir = (workspace_root or find_workspace_root()) / ".agents" / "clusters"
                target_scope = "workspace (.agents/clusters)"
            else:
                target_dir = self.hub_dir / "clusters"
                target_scope = "hub (clusters)"
            target_dir.mkdir(parents=True, exist_ok=True)
            target = target_dir / f"{name}.json"
            if target.exists():
                print(f"{COLOR_RED}Error:{COLOR_RESET} Cluster '{name}' already exists at {target}")
                return
            boilerplate = {
                "name": name,
                "description": f"Curated skill cluster for {name}",
                "skills": [],
                "plugins": []
            }
            target.write_text(json.dumps(boilerplate, indent=2) + "\n", encoding="utf-8")
            print(f"{COLOR_GREEN}✓{COLOR_RESET} Created new {target_scope} cluster '{COLOR_BOLD}{name}{COLOR_RESET}' at {target}")
            print(f"Edit {target} to add skill names to the cluster.")

    def add_repo(self, url: str, name: str | None = None, branch: str = "main"):
        """Registers and clones a new GitHub skills repository as a git submodule in external/."""
        if not name:
            clean_url = url.rstrip("/")
            if clean_url.endswith(".git"):
                clean_url = clean_url[:-4]
            name = clean_url.split("/")[-1]

        target_dir = self.hub_dir / "external" / name
        submodule_path = f"external/{name}"
        if target_dir.exists():
            print(f"{COLOR_RED}Error:{COLOR_RESET} Directory '{name}' already exists at {target_dir}")
            return

        print(f"\nAdding submodule {COLOR_BOLD}{name}{COLOR_RESET} from {url} into {submodule_path} (branch: {branch})...\n")
        cmd = ["git", "submodule", "add", "-b", branch, url, submodule_path]
        res = subprocess.run(cmd, cwd=self.hub_dir)
        if res.returncode == 0:
            print(f"\n{COLOR_GREEN}✓{COLOR_RESET} Successfully added repository '{COLOR_BOLD}{name}{COLOR_RESET}' as submodule!")
            # Stage .gitmodules and submodule
            subprocess.run(["git", "add", ".gitmodules", submodule_path], cwd=self.hub_dir)
            print(f"Run {COLOR_BOLD}agyhub list -g {name}{COLOR_RESET} to view newly available skills.")
        else:
            print(f"{COLOR_RED}✗ Failed to add submodule.{COLOR_RESET}")

    def info(self, name: str):
        """Displays detailed documentation and content for a specific skill or plugin."""
        all_skills, all_plugins = self.get_available()

        if name in all_skills:
            info = all_skills[name]
            skill_path = info["path"]
            skill_md = skill_path / "SKILL.md"

            print(f"\n{COLOR_CYAN}{COLOR_BOLD}Skill:{COLOR_RESET} {COLOR_BOLD}{name}{COLOR_RESET}")
            print(f"{COLOR_BOLD}Group/Source:{COLOR_RESET} {info['group']}")
            print(f"{COLOR_BOLD}Location:{COLOR_RESET}     {skill_path}")

            if skill_md.exists():
                content = skill_md.read_text(encoding="utf-8", errors="replace")
                print(f"\n{COLOR_BOLD}=== Documentation (SKILL.md) ==={COLOR_RESET}\n")
                lines = content.splitlines()
                # If frontmatter exists, show description then body
                in_fm = False
                body_lines = []
                for line in lines:
                    if line.strip() == "---":
                        in_fm = not in_fm
                        continue
                    if not in_fm:
                        body_lines.append(line)

                rendered = "\n".join(body_lines).strip()
                if rendered:
                    # Print first 50 lines if very long
                    disp_lines = rendered.splitlines()
                    if len(disp_lines) > 55:
                        print("\n".join(disp_lines[:55]))
                        print(f"\n{COLOR_DIM}... [{len(disp_lines) - 55} more lines in {skill_md}] ...{COLOR_RESET}\n")
                    else:
                        print(rendered + "\n")
                else:
                    print(f"{COLOR_DIM}No additional documentation found.{COLOR_RESET}\n")

        elif name in all_plugins:
            info = all_plugins[name]
            plugin_path = info["path"]
            manifest = plugin_path / "plugin.json"

            print(f"\n{COLOR_CYAN}{COLOR_BOLD}Plugin:{COLOR_RESET} {COLOR_BOLD}{name}{COLOR_RESET}")
            print(f"{COLOR_BOLD}Group/Source:{COLOR_RESET} {info['group']}")
            print(f"{COLOR_BOLD}Location:{COLOR_RESET}     {plugin_path}")

            if manifest.exists():
                try:
                    data = json.loads(manifest.read_text(encoding="utf-8"))
                    print(f"\n{COLOR_BOLD}Description:{COLOR_RESET} {data.get('description', 'N/A')}")
                    if "version" in data:
                        print(f"{COLOR_BOLD}Version:{COLOR_RESET}     {data['version']}")
                except Exception:
                    pass

            # List any bundled skills
            p_skills_dir = plugin_path / "skills"
            if p_skills_dir.exists():
                p_skills = [d.name for d in p_skills_dir.iterdir() if d.is_dir()]
                if p_skills:
                    print(f"\n{COLOR_BOLD}Bundled Skills ({len(p_skills)}):{COLOR_RESET}")
                    for s in sorted(p_skills):
                        print(f"  • {s}")
            print()
        else:
            print(f"\n{COLOR_RED}✗ Unknown skill or plugin:{COLOR_RESET} '{name}'")
            print(f"Tip: Run {COLOR_BOLD}agyhub list {name}{COLOR_RESET} to search matching customizations.\n")


def cmd_list(manager: HubManager, workspace_root: Path, query: str | None = None, group_filter: str | None = None, show_all: bool = False):
    all_skills, all_plugins = manager.get_available()
    active_skills, active_plugins = manager.get_workspace_active(workspace_root)
    glob_skills, glob_plugins = manager.get_global_active()
    skill_to_plugin, _ = manager.get_plugin_skills_map(skills=all_skills, plugins=all_plugins)

    print(f"\n{COLOR_BOLD}Antigravity Hub:{COLOR_RESET} {manager.hub_dir}")
    print(f"{COLOR_BOLD}Current Workspace:{COLOR_RESET} {workspace_root}\n")

    # If no search query, no group filter, and not show_all, show summary overview first
    if not query and not group_filter and not show_all:
        groups = {}
        for s, info in all_skills.items():
            grp = info["group"]
            top = "/".join(grp.split("/")[:2]) if "/" in grp else grp
            groups.setdefault(top, {"skills": 0, "active_ws": 0, "active_glob": 0})
            groups[top]["skills"] += 1
            if s in active_skills:
                groups[top]["active_ws"] += 1
            if s in glob_skills:
                groups[top]["active_glob"] += 1

        cm = ClusterManager(hub_dir=manager.hub_dir, workspace_root=workspace_root)
        clusters = cm.load_clusters()
        cluster_str = f", {len(clusters)} clusters" if clusters else ""
        print(f"{COLOR_BOLD}Catalog Summary: {len(all_skills)} skills, {len(all_plugins)} plugins across {len(groups)} sources{cluster_str}:{COLOR_RESET}")
        for g, counts in sorted(groups.items()):
            details = []
            if counts["active_ws"]:
                details.append(f"{COLOR_GREEN}{counts['active_ws']} workspace{COLOR_RESET}")
            if counts["active_glob"]:
                details.append(f"{COLOR_MAGENTA}{counts['active_glob']} global{COLOR_RESET}")
            act_str = f" ({', '.join(details)} active)" if details else ""
            print(f"  • {COLOR_CYAN}{COLOR_BOLD}{g:<26}{COLOR_RESET}: {counts['skills']} skills{act_str}")
        print()

        # If any skills/plugins are active in current workspace or globally, display them
        if active_skills or active_plugins or glob_skills or glob_plugins:
            if active_skills or active_plugins:
                print(f"{COLOR_CYAN}{COLOR_BOLD}=== Active in Workspace ==={COLOR_RESET}")
                for s, mode in sorted(active_skills.items()):
                    info = all_skills.get(s, {})
                    grp = f" [{info.get('group', 'unknown')}]" if info else ""
                    print(f"  {COLOR_GREEN}[WORKSPACE ({mode})]{COLOR_RESET} {COLOR_BOLD}{s:<32}{COLOR_RESET}{COLOR_DIM}{grp}{COLOR_RESET}")
                for p, mode in sorted(active_plugins.items()):
                    print(f"  {COLOR_GREEN}[WORKSPACE ({mode})]{COLOR_RESET} {COLOR_BOLD}{p:<32}{COLOR_RESET}{COLOR_DIM} [plugin]{COLOR_RESET}")
                print()

            if glob_skills or glob_plugins:
                print(f"{COLOR_MAGENTA}{COLOR_BOLD}=== Active Globally (All Workspaces) ==={COLOR_RESET}")
                for s, mode in sorted(glob_skills.items()):
                    info = all_skills.get(s, {})
                    grp = f" [{info.get('group', 'unknown')}]" if info else ""
                    print(f"  {COLOR_MAGENTA}[GLOBAL ({mode})]{COLOR_RESET}    {COLOR_BOLD}{s:<32}{COLOR_RESET}{COLOR_DIM}{grp}{COLOR_RESET}")
                for p, mode in sorted(glob_plugins.items()):
                    print(f"  {COLOR_MAGENTA}[GLOBAL ({mode})]{COLOR_RESET}    {COLOR_BOLD}{p:<32}{COLOR_RESET}{COLOR_DIM} [plugin]{COLOR_RESET}")
                print()

        print(f"{COLOR_DIM}Tips:{COLOR_RESET}")
        print(f"  List clusters:      {COLOR_BOLD}agyhub cluster list{COLOR_RESET} (or {COLOR_BOLD}agyhub clusters{COLOR_RESET})")
        print(f"  Enable cluster:     {COLOR_BOLD}agyhub enable -c <cluster>{COLOR_RESET}")
        print(f"  Search skills:      {COLOR_BOLD}agyhub list <query>{COLOR_RESET} (e.g. 'agyhub list bigquery', 'agyhub list alphafold')")
        print(f"  Filter by group:    {COLOR_BOLD}agyhub list -g deepmind-science{COLOR_RESET} or {COLOR_BOLD}agyhub list -g cloud{COLOR_RESET}")
        print(f"  View all 200+:      {COLOR_BOLD}agyhub list --all{COLOR_RESET}")
        print(f"  Enable globally:    {COLOR_BOLD}agyhub enable -G <name>{COLOR_RESET} or {COLOR_BOLD}agyhub enable -G -g <group>{COLOR_RESET}")
        print(f"  Interactive select: {COLOR_BOLD}agyhub select{COLOR_RESET} (or {COLOR_BOLD}agyhub -i{COLOR_RESET})")
        print(f"  Check for updates:  {COLOR_BOLD}agyhub update --check{COLOR_RESET}\n")
        return

    # Filtered view
    q = query.lower() if query else ""
    gf = group_filter.lower() if group_filter else ""

    matching_skills = {}
    for name, info in all_skills.items():
        if gf:
            if not _match_group(gf, info["group"]):
                continue
        if q and q not in name.lower() and q not in info["desc"].lower() and q not in info["group"].lower():
            continue
        matching_skills[name] = info

    matching_plugins = {}
    for name, info in all_plugins.items():
        if gf:
            if not _match_group(gf, info["group"]):
                continue
        if q and q not in name.lower() and q not in info["desc"].lower() and q not in info["group"].lower():
            continue
        matching_plugins[name] = info

    header = f"Found {len(matching_skills)} skills" + (f", {len(matching_plugins)} plugins" if matching_plugins else "")
    if q:
        header += f" matching '{query}'"
    if gf:
        header += f" in group '{group_filter}'"
    print(f"{COLOR_BOLD}{header}:{COLOR_RESET}\n")

    # Group matches by group
    by_group = {}
    for name, info in matching_skills.items():
        by_group.setdefault(info["group"], {})[name] = info

    for grp, items in sorted(by_group.items()):
        print(f"{COLOR_CYAN}{COLOR_BOLD}=== {grp} ({len(items)}) ==={COLOR_RESET}")
        for name, info in sorted(items.items()):
            in_ws = name in active_skills
            in_glob = name in glob_skills
            parent_p = skill_to_plugin.get(name)
            via_ws = parent_p and parent_p in active_plugins
            via_glob = parent_p and parent_p in glob_plugins

            if in_ws and in_glob:
                badge = f"{COLOR_GREEN}[BOTH ({active_skills[name]}/{glob_skills[name]})]{COLOR_RESET}"
            elif in_ws:
                badge = f"{COLOR_GREEN}[WORKSPACE ({active_skills[name]})]{COLOR_RESET}"
            elif in_glob:
                badge = f"{COLOR_MAGENTA}[GLOBAL ({glob_skills[name]})]{COLOR_RESET}   "
            elif via_ws and via_glob:
                badge = f"{COLOR_GREEN}[BOTH (plugin)]{COLOR_RESET}      "
            elif via_ws:
                badge = f"{COLOR_GREEN}[WORKSPACE (plugin)]{COLOR_RESET} "
            elif via_glob:
                badge = f"{COLOR_MAGENTA}[GLOBAL (plugin)]{COLOR_RESET}    "
            else:
                badge = f"{COLOR_DIM}[                   ]{COLOR_RESET}"
            desc = f" - {COLOR_DIM}{info['desc']}{COLOR_RESET}" if info['desc'] else ""
            print(f"  {badge} {COLOR_BOLD}{name:<32}{COLOR_RESET}{desc}")
        print()

    if matching_plugins:
        print(f"{COLOR_CYAN}{COLOR_BOLD}=== Plugins ({len(matching_plugins)}) ==={COLOR_RESET}")
        for name, info in sorted(matching_plugins.items()):
            in_ws = name in active_plugins
            in_glob = name in glob_plugins
            if in_ws and in_glob:
                badge = f"{COLOR_GREEN}[BOTH]{COLOR_RESET}     "
            elif in_ws:
                badge = f"{COLOR_GREEN}[WORKSPACE]{COLOR_RESET}"
            elif in_glob:
                badge = f"{COLOR_MAGENTA}[GLOBAL]{COLOR_RESET}   "
            else:
                badge = f"{COLOR_DIM}[         ]{COLOR_RESET}"
            desc = f" - {COLOR_DIM}{info['desc']}{COLOR_RESET}" if info['desc'] else ""
            print(f"  {badge} {COLOR_BOLD}{name:<32}{COLOR_RESET} [{info['group']}]{desc}")
        print()


def cmd_status(manager: HubManager, workspace_root: Path, is_global: bool = False):
    all_skills, all_plugins = manager.get_available()
    skill_to_plugin, _ = manager.get_plugin_skills_map(skills=all_skills, plugins=all_plugins)

    if is_global:
        active_skills, active_plugins = manager.get_global_active()
        print(f"\n{COLOR_BOLD}Scope:{COLOR_RESET} {COLOR_MAGENTA}GLOBAL{COLOR_RESET} (~/.gemini/config)")
        print(f"{COLOR_BOLD}Hub Directory:{COLOR_RESET} {manager.hub_dir}\n")

        if not active_skills and not active_plugins:
            print(f"{COLOR_YELLOW}No skills or plugins currently activated globally.{COLOR_RESET}")
            print(f"Run {COLOR_BOLD}agyhub enable -G <name>{COLOR_RESET} to activate customizations globally.\n")
            return

        print(f"{COLOR_CYAN}{COLOR_BOLD}Active Global Skills ({len(active_skills)}):{COLOR_RESET}")
        for s, mode in sorted(active_skills.items()):
            grp = f" [{all_skills[s]['group']}]" if s in all_skills else ""
            parent_p = skill_to_plugin.get(s)
            dup_warn = ""
            if parent_p and parent_p in active_plugins:
                dup_warn = f" {COLOR_YELLOW}[DUPLICATE: also provided by active global plugin '{parent_p}']{COLOR_RESET}"
            print(f"  {COLOR_GREEN}✓{COLOR_RESET} {s:<32} {COLOR_DIM}(via {mode}){COLOR_RESET}{COLOR_DIM}{grp}{COLOR_RESET}{dup_warn}")

        if active_plugins:
            print(f"\n{COLOR_CYAN}{COLOR_BOLD}Active Global Plugins ({len(active_plugins)}):{COLOR_RESET}")
            for p, mode in sorted(active_plugins.items()):
                grp = f" [{all_plugins[p]['group']}]" if p in all_plugins else ""
        if active_skills or active_plugins:
            print(f"\n{COLOR_DIM}💡 Global customizations reference '{manager.hub_dir}'. Ensure this path has File Read permission in your editor/tool.{COLOR_RESET}")
        print()
        return

    # Workspace status
    ws_skills, ws_plugins = manager.get_workspace_active(workspace_root)
    glob_skills, glob_plugins = manager.get_global_active()

    print(f"\n{COLOR_BOLD}Workspace:{COLOR_RESET} {workspace_root}")
    print(f"{COLOR_BOLD}Hub Directory:{COLOR_RESET} {manager.hub_dir}\n")

    if not ws_skills and not ws_plugins:
        print(f"{COLOR_YELLOW}No skills or plugins currently activated in this workspace.{COLOR_RESET}")
        print(f"Run {COLOR_BOLD}agyhub list{COLOR_RESET} or {COLOR_BOLD}agyhub enable <name>{COLOR_RESET} to activate customizations.")
    else:
        print(f"{COLOR_CYAN}{COLOR_BOLD}Active Workspace Skills ({len(ws_skills)}):{COLOR_RESET}")
        for s, mode in sorted(ws_skills.items()):
            grp = f" [{all_skills[s]['group']}]" if s in all_skills else ""
            parent_p = skill_to_plugin.get(s)
            dup_warn = ""
            if parent_p and parent_p in ws_plugins:
                dup_warn = f" {COLOR_YELLOW}[DUPLICATE: also provided by active plugin '{parent_p}']{COLOR_RESET}"
            print(f"  {COLOR_GREEN}✓{COLOR_RESET} {s:<32} {COLOR_DIM}(via {mode}){COLOR_RESET}{COLOR_DIM}{grp}{COLOR_RESET}{dup_warn}")

        if ws_plugins:
            print(f"\n{COLOR_CYAN}{COLOR_BOLD}Active Workspace Plugins ({len(ws_plugins)}):{COLOR_RESET}")
            for p, mode in sorted(ws_plugins.items()):
                grp = f" [{all_plugins[p]['group']}]" if p in all_plugins else ""
                print(f"  {COLOR_GREEN}✓{COLOR_RESET} {p:<32} {COLOR_DIM}(via {mode}){COLOR_RESET}{COLOR_DIM}{grp}{COLOR_RESET}")

    if glob_skills or glob_plugins:
        if glob_skills:
            print(f"\n{COLOR_MAGENTA}{COLOR_BOLD}Active Global Skills ({len(glob_skills)}) [Inherited by all workspaces]:{COLOR_RESET}")
            for s, mode in sorted(glob_skills.items()):
                grp = f" [{all_skills[s]['group']}]" if s in all_skills else ""
                print(f"  {COLOR_MAGENTA}🌐{COLOR_RESET} {s:<32} {COLOR_DIM}(via global {mode}){COLOR_RESET}{COLOR_DIM}{grp}{COLOR_RESET}")
        if glob_plugins:
            print(f"\n{COLOR_MAGENTA}{COLOR_BOLD}Active Global Plugins ({len(glob_plugins)}) [Inherited by all workspaces]:{COLOR_RESET}")
            for p, mode in sorted(glob_plugins.items()):
                grp = f" [{all_plugins[p]['group']}]" if p in all_plugins else ""
                print(f"  {COLOR_MAGENTA}🌐{COLOR_RESET} {p:<32} {COLOR_DIM}(via global {mode}){COLOR_RESET}{COLOR_DIM}{grp}{COLOR_RESET}")

    cm = ClusterManager(hub_dir=manager.hub_dir, workspace_root=workspace_root)
    clusters = cm.load_clusters()
    if clusters:
        matched_active = []
        matched_partial = []
        check_skills = glob_skills if is_global else ws_skills
        check_plugins = glob_plugins if is_global else ws_plugins
        for c_name, c_info in sorted(clusters.items()):
            act, tot, status = cm.get_cluster_status(c_info, check_skills, check_plugins, skill_to_plugin=skill_to_plugin)
            if status == "ACTIVE":
                matched_active.append((c_name, act, tot))
            elif status == "PARTIAL":
                matched_partial.append((c_name, act, tot))

        if matched_active or matched_partial:
            scope_desc = "Global" if is_global else "Workspace"
            print(f"\n{COLOR_CYAN}{COLOR_BOLD}Matched Clusters ({scope_desc}):{COLOR_RESET}")
            for c_name, act, tot in matched_active:
                print(f"  {COLOR_GREEN}✓{COLOR_RESET} {COLOR_BOLD}{c_name:<24}{COLOR_RESET} ({act}/{tot} active)")
            for c_name, act, tot in matched_partial:
                print(f"  {COLOR_YELLOW}◐{COLOR_RESET} {c_name:<24} ({act}/{tot} active)")

    if workspace_root.resolve() != manager.hub_dir.resolve() and (ws_skills or ws_plugins):
        print(f"\n{COLOR_DIM}💡 Active customizations reference '{manager.hub_dir}'. Ensure this path has File Read permission in your editor/tool.{COLOR_RESET}")
    print()


def cmd_cluster(manager: HubManager, workspace_root: Path, action: str | None = "list", name: str | None = None, is_global: bool = False, configure_permissions: bool = True, clean_permissions: bool = False, is_local: bool = False):
    cm = ClusterManager(hub_dir=manager.hub_dir, workspace_root=workspace_root)
    clusters = cm.load_clusters()
    active_skills, active_plugins = manager.get_active(workspace_root=workspace_root, is_global=is_global)
    all_skills, all_plugins = manager.get_available()
    skill_to_plugin, _ = manager.get_plugin_skills_map(skills=all_skills, plugins=all_plugins)

    if action in ("list", "ls") or action is None:
        print(f"\n{COLOR_BOLD}Antigravity Hub Clusters:{COLOR_RESET} {manager.hub_dir}")
        print(f"{COLOR_BOLD}Target Scope:{COLOR_RESET} {'GLOBAL (~/.gemini/config)' if is_global else f'WORKSPACE ({workspace_root})'}\n")

        if not clusters:
            print(f"{COLOR_YELLOW}No clusters found.{COLOR_RESET}")
            print(f"Create a cluster using: {COLOR_BOLD}agyhub create cluster <name>{COLOR_RESET} or add JSON files to {manager.hub_dir}/clusters/\n")
            return

        for c_name, c_info in sorted(clusters.items()):
            act, tot, status = cm.get_cluster_status(c_info, active_skills, active_plugins, skill_to_plugin=skill_to_plugin)
            if status == "ACTIVE":
                badge = f"{COLOR_GREEN}[ACTIVE ({act}/{tot})]{COLOR_RESET}"
            elif status == "PARTIAL":
                badge = f"{COLOR_YELLOW}[PARTIAL ({act}/{tot})]{COLOR_RESET}"
            else:
                badge = f"{COLOR_DIM}[INACTIVE (0/{tot})]{COLOR_RESET}"

            src = c_info.get("source", "")
            hub_clusters_path = str(manager.hub_dir / "clusters")
            hub_internal_clusters_path = str(manager.hub_dir / "internal" / "clusters")
            if src.startswith(hub_clusters_path) or src.startswith(hub_internal_clusters_path):
                scope_badge = f"{COLOR_MAGENTA}[HUB]{COLOR_RESET}      "
            else:
                scope_badge = f"{COLOR_CYAN}[WORKSPACE]{COLOR_RESET}"

            desc = f" - {COLOR_DIM}{c_info['description']}{COLOR_RESET}" if c_info.get('description') else ""
            print(f"  {badge:<28} {scope_badge} {COLOR_BOLD}{c_name:<28}{COLOR_RESET}{desc}")

        print(f"\n{COLOR_DIM}Tips:{COLOR_RESET}")
        print(f"  Inspect a cluster:        {COLOR_BOLD}agyhub cluster info <name>{COLOR_RESET}")
        print(f"  Enable a cluster:         {COLOR_BOLD}agyhub enable -c <name>{COLOR_RESET} (or {COLOR_BOLD}agyhub cluster enable <name>{COLOR_RESET})")
        print(f"  Disable a cluster:        {COLOR_BOLD}agyhub disable -c <name>{COLOR_RESET}")
        print(f"  Create hub cluster:       {COLOR_BOLD}agyhub create cluster <name>{COLOR_RESET}")
        print(f"  Create workspace cluster: {COLOR_BOLD}agyhub create cluster <name> --local{COLOR_RESET}\n")

    elif action in ("create", "new"):
        if not name:
            print(f"{COLOR_RED}Please specify a cluster name.{COLOR_RESET} Example: agyhub cluster create my-role")
            return
        manager.scaffold("cluster", name, is_local=is_local, workspace_root=workspace_root)

    elif action in ("info", "show", "describe"):
        if not name:
            print(f"{COLOR_RED}Please specify a cluster name.{COLOR_RESET} Example: agyhub cluster info gcp-data-enterprise-architect")
            return
        if name not in clusters:
            print(f"{COLOR_RED}Unknown cluster:{COLOR_RESET} '{name}'. Available: {', '.join(sorted(clusters.keys()))}")
            return

        c_info = clusters[name]
        act, tot, status = cm.get_cluster_status(c_info, active_skills, active_plugins, skill_to_plugin=skill_to_plugin)

        print(f"\n{COLOR_CYAN}{COLOR_BOLD}Cluster:{COLOR_RESET}     {COLOR_BOLD}{name}{COLOR_RESET}")
        print(f"{COLOR_BOLD}Description:{COLOR_RESET} {c_info.get('description', 'N/A')}")
        print(f"{COLOR_BOLD}Source File:{COLOR_RESET} {c_info.get('source', 'N/A')}")
        print(f"{COLOR_BOLD}Status:{COLOR_RESET}      {act}/{tot} active in {'GLOBAL' if is_global else 'WORKSPACE'}")

        skills = c_info.get("skills", [])
        if skills:
            print(f"\n{COLOR_BOLD}Included Skills ({len(skills)}):{COLOR_RESET}")
            for s in skills:
                is_act = s in active_skills
                parent_p = skill_to_plugin.get(s)
                via_plugin = parent_p and parent_p in active_plugins
                if is_act:
                    stat_badge = f"{COLOR_GREEN}✓ active{COLOR_RESET}"
                elif via_plugin:
                    stat_badge = f"{COLOR_GREEN}✓ active (via plugin:{parent_p}){COLOR_RESET}"
                else:
                    stat_badge = f"{COLOR_DIM}○ inactive{COLOR_RESET}"
                info = all_skills.get(s, {})
                local_dir = workspace_root / ".agents" / "skills" / s
                if info:
                    grp = f" [{info.get('group', 'unknown')}]"
                    desc = f" - {COLOR_DIM}{info.get('desc', '')}{COLOR_RESET}" if info.get('desc') else ""
                elif local_dir.exists():
                    local_desc = get_skill_description(local_dir)
                    grp = f" {COLOR_CYAN}[workspace/local]{COLOR_RESET}"
                    desc = f" - {COLOR_DIM}{local_desc}{COLOR_RESET}" if local_desc else ""
                else:
                    grp = f" {COLOR_RED}[NOT FOUND IN CATALOG]{COLOR_RESET}"
                    desc = ""
                print(f"  {stat_badge:<40} {COLOR_BOLD}{s:<36}{COLOR_RESET}{grp}{desc}")

        plugins = c_info.get("plugins", [])
        if plugins:
            print(f"\n{COLOR_BOLD}Included Plugins ({len(plugins)}):{COLOR_RESET}")
            for p in plugins:
                is_act = p in active_plugins
                stat_badge = f"{COLOR_GREEN}✓ active{COLOR_RESET}" if is_act else f"{COLOR_DIM}○ inactive{COLOR_RESET}"
                info = all_plugins.get(p, {})
                grp = f" [{info.get('group', 'unknown')}]" if info else f" {COLOR_RED}[NOT FOUND IN CATALOG]{COLOR_RESET}"
                desc = f" - {COLOR_DIM}{info.get('desc', '')}{COLOR_RESET}" if info.get('desc') else ""
                print(f"  {stat_badge:<20} {COLOR_BOLD}{p:<36}{COLOR_RESET}{grp}{desc}")
        print()

    elif action == "enable":
        if not name:
            print(f"{COLOR_RED}Please specify a cluster name to enable.{COLOR_RESET}")
            return
        manager.enable(workspace_root=workspace_root, clusters=[name], is_global=is_global, configure_permissions=configure_permissions)

    elif action == "disable":
        if not name:
            print(f"{COLOR_RED}Please specify a cluster name to disable.{COLOR_RESET}")
            return
        manager.disable(workspace_root=workspace_root, clusters=[name], is_global=is_global, clean_permissions=clean_permissions)


def cmd_interactive(manager: HubManager, workspace_root: Path):
    all_skills, all_plugins = manager.get_available()
    active_skills, active_plugins = manager.get_workspace_active(workspace_root)

    print(f"\n{COLOR_BOLD}Interactive Customization Selector{COLOR_RESET}")
    print(f"Workspace: {workspace_root}")
    print(f"Catalog: {len(all_skills)} skills, {len(all_plugins)} plugins available.\n")

    filter_query = input(f"{COLOR_BOLD}Optional search filter (press Enter to show all / active): {COLOR_RESET}").strip().lower()

    items = []
    for name, info in sorted(all_skills.items()):
        is_act = active_skills.get(name) is not None
        if not filter_query or filter_query in name.lower() or filter_query in info["desc"].lower() or filter_query in info["group"].lower() or is_act:
            items.append((name, "skill", is_act, info["group"], info["desc"]))

    for name, info in sorted(all_plugins.items()):
        is_act = active_plugins.get(name) is not None
        if not filter_query or filter_query in name.lower() or filter_query in info["desc"].lower() or filter_query in info["group"].lower() or is_act:
            items.append((name, "plugin", is_act, info["group"], info["desc"]))

    if not items:
        print(f"No customizations matching '{filter_query}'.")
        return

    selected = {name: is_act for name, _, is_act, _, _ in items}

    print("\nToggle items by entering numbers (e.g. '1 3 5').")
    print("Type 'save' to apply changes, or 'q' to quit without saving.\n")

    while True:
        print("-" * 80)
        for i, (name, itype, _, grp, desc) in enumerate(items, 1):
            box = f"{COLOR_GREEN}[x]{COLOR_RESET}" if selected[name] else "[ ]"
            tag = f"{COLOR_CYAN}[{grp[:15]}]{COLOR_RESET}"
            print(f"  {i:>3}. {box} {tag:<22} {COLOR_BOLD}{name:<30}{COLOR_RESET} {COLOR_DIM}{desc[:35]}{COLOR_RESET}")
        print("-" * 80)

        choice = input(f"{COLOR_BOLD}Enter numbers to toggle, 'save', or 'q': {COLOR_RESET}").strip().lower()
        if choice in ('q', 'quit', 'exit'):
            print("Aborted without changes.")
            return
        if choice in ('save', 's', 'done'):
            break

        parts = choice.replace(',', ' ').split()
        for p in parts:
            if p.isdigit():
                idx = int(p) - 1
                if 0 <= idx < len(items):
                    item_name = items[idx][0]
                    selected[item_name] = not selected[item_name]
                    print(f"Toggled '{item_name}' -> {'ON' if selected[item_name] else 'OFF'}")

    to_enable = [name for name, is_sel in selected.items() if is_sel and not (active_skills.get(name) or active_plugins.get(name))]
    to_disable = [name for name, is_sel in selected.items() if not is_sel and (active_skills.get(name) or active_plugins.get(name))]

    if to_enable:
        manager.enable(workspace_root, to_enable)
    if to_disable:
        manager.disable(workspace_root, to_disable)

    print(f"\n{COLOR_GREEN}{COLOR_BOLD}Workspace configuration updated successfully!{COLOR_RESET}\n")


def main():
    parser = argparse.ArgumentParser(
        prog="agyhub",
        description="Zero-copy Antigravity Customizations Manager"
    )
    parser.add_argument("--hub", type=Path, default=DEFAULT_HUB_DIR, help=f"Path to skills hub (default: {DEFAULT_HUB_DIR})")
    parser.add_argument("--workspace", "-w", type=Path, default=None, help="Target workspace root (default: current directory)")
    parser.add_argument("--find-root", "-r", action="store_true", help="Search parent directories for .git or .agents root instead of using current directory")
    parser.add_argument("--global", "-G", dest="is_global", action="store_true", help="Target machine-wide global configuration (~/.gemini/config) instead of local workspace")

    common_sub = argparse.ArgumentParser(add_help=False)
    common_sub.add_argument("--workspace", "-w", type=Path, default=argparse.SUPPRESS, help="Target workspace root (default: current directory)")
    common_sub.add_argument("--find-root", "-r", action="store_true", default=argparse.SUPPRESS, help="Search parent directories for .git or .agents root")
    common_sub.add_argument("--global", "-G", dest="is_global", action="store_true", default=argparse.SUPPRESS, help="Target machine-wide global configuration (~/.gemini/config)")

    subparsers = parser.add_subparsers(dest="command", help="Subcommand to run")

    # list
    p_list = subparsers.add_parser("list", aliases=["ls"], parents=[common_sub], help="List available skills and plugins")
    p_list.add_argument("query", nargs="?", default=None, help="Optional search query")
    p_list.add_argument("--group", "-g", default=None, help="Filter by group/repository name")
    p_list.add_argument("--all", "-a", action="store_true", help="Print all skills in the catalog")

    # status
    p_status = subparsers.add_parser("status", parents=[common_sub], help="Show active customizations in current workspace or global scope")

    # cluster
    p_cluster = subparsers.add_parser("cluster", aliases=["clusters"], parents=[common_sub], help="Manage predefined skill clusters")
    p_cluster.add_argument("cluster_action", choices=["list", "ls", "info", "show", "describe", "enable", "disable", "create", "new"], nargs="?", default="list", help="Cluster action (default: list)")
    p_cluster.add_argument("cluster_name", nargs="?", default=None, help="Cluster name for info, enable, disable, or create")
    p_cluster.add_argument("--local", action="store_true", dest="is_local", help="Target local workspace (.agents/clusters) instead of official hub clusters")
    p_cluster.add_argument("--no-permissions", dest="configure_permissions", action="store_false", default=True, help="Suppress non-workspace file read notice")
    p_cluster.add_argument("--clean-permissions", action="store_true", help="Deprecated no-op (retained for backward compatibility)")

    # enable
    p_enable = subparsers.add_parser("enable", aliases=["add"], parents=[common_sub], help="Enable skills, plugins, or clusters in workspace or globally")
    p_enable.add_argument("names", nargs="*", default=[], help="Names of skills or plugins to enable")
    p_enable.add_argument("--cluster", "-c", action="append", default=[], help="Enable all skills in specified cluster (can be repeated)")
    p_enable.add_argument("--group", "-g", default=None, help="Enable all skills from a specific group/repository (e.g. agents-cli, deepmind-science)")
    p_enable.add_argument("--symlink", "-s", action="store_true", help="Use symlinks instead of .agents/skills.json manifest")
    p_enable.add_argument("--no-permissions", dest="configure_permissions", action="store_false", default=True, help="Suppress non-workspace file read notice")

    # disable
    p_disable = subparsers.add_parser("disable", aliases=["rm"], parents=[common_sub], help="Disable skills, plugins, or clusters in workspace or globally")
    p_disable.add_argument("names", nargs="*", default=[], help="Names of skills or plugins to disable")
    p_disable.add_argument("--cluster", "-c", action="append", default=[], help="Disable all skills in specified cluster (can be repeated)")
    p_disable.add_argument("--group", "-g", default=None, help="Disable all skills from a specific group/repository")
    p_disable.add_argument("--all", "-a", action="store_true", help="Disable all active customizations in target scope")
    p_disable.add_argument("--clean-permissions", action="store_true", help="Deprecated no-op (retained for backward compatibility)")

    # info / show / describe
    p_info = subparsers.add_parser("info", aliases=["show", "describe"], help="Display documentation and instructions for a skill or plugin")
    p_info.add_argument("name", help="Name of the skill or plugin")

    # select / interactive
    p_select = subparsers.add_parser("select", aliases=["interactive", "-i"], parents=[common_sub], help="Interactive checklist to select active skills")

    # update
    p_update = subparsers.add_parser("update", help="Update skills repositories from original GitHub")
    p_update.add_argument("repos", nargs="*", default=None, help="Specific repositories to update (default: all)")
    p_update.add_argument("--check", "-c", action="store_true", help="Check for available updates without applying them")

    # add-repo
    p_add_repo = subparsers.add_parser("add-repo", help="Register and clone a new GitHub repository as a submodule in the hub")
    p_add_repo.add_argument("url", help="GitHub repository URL")
    p_add_repo.add_argument("name", nargs="?", default=None, help="Submodule directory name (optional, derived from URL)")
    p_add_repo.add_argument("--branch", "-b", default="main", help="Branch to track (default: main)")

    # create
    p_create = subparsers.add_parser("create", parents=[common_sub], help="Create a new skill, plugin, rule, or cluster template")
    p_create.add_argument("type", choices=["skill", "plugin", "rule", "cluster"], help="Type to create")
    p_create.add_argument("name", help="Name of the skill, plugin, rule, or cluster")
    p_create.add_argument("--group", "-g", default=None, help="Typology group for internal items (default: templates; e.g. hub-tools, data-platform)")
    p_create.add_argument("--local", action="store_true", dest="is_local", help="Create inside local workspace (.agents/skills or .agents/clusters) rather than hub")

    args = parser.parse_args()

    manager = HubManager(hub_dir=args.hub)
    workspace_root = args.workspace.resolve() if args.workspace else find_workspace_root(find_root=getattr(args, "find_root", False))
    is_global = getattr(args, "is_global", False)

    if args.command in ("list", "ls") or args.command is None:
        cmd_list(manager, workspace_root, query=getattr(args, "query", None), group_filter=getattr(args, "group", None), show_all=getattr(args, "all", False))
    elif args.command == "status":
        cmd_status(manager, workspace_root, is_global=is_global)
    elif args.command in ("cluster", "clusters"):
        cmd_cluster(manager, workspace_root, action=args.cluster_action, name=args.cluster_name, is_global=is_global, configure_permissions=getattr(args, "configure_permissions", True), clean_permissions=getattr(args, "clean_permissions", False), is_local=getattr(args, "is_local", False))
    elif args.command in ("info", "show", "describe"):
        manager.info(args.name)
    elif args.command in ("enable", "add"):
        manager.enable(workspace_root, names=args.names, clusters=args.cluster, group=args.group, as_symlink=args.symlink, is_global=is_global, configure_permissions=getattr(args, "configure_permissions", True))
    elif args.command in ("disable", "rm"):
        manager.disable(workspace_root, names=args.names, clusters=args.cluster, group=args.group, disable_all=args.all, is_global=is_global, clean_permissions=getattr(args, "clean_permissions", False))
    elif args.command in ("select", "interactive", "-i"):
        cmd_interactive(manager, workspace_root)
    elif args.command == "update":
        manager.update_repos(targets=args.repos if args.repos else None, check_only=args.check)
    elif args.command == "add-repo":
        manager.add_repo(args.url, name=args.name, branch=args.branch)
    elif args.command == "create":
        manager.scaffold(args.type, args.name, group=getattr(args, "group", None), is_local=getattr(args, "is_local", False), workspace_root=workspace_root)
    else:
        parser.print_help()

if __name__ == "__main__":
    main()

