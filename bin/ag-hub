#!/usr/bin/env python3
"""
ag-hub: Zero-copy Antigravity Customizations Manager
Manage and selectively activate Antigravity skills and plugins in any workspace.
"""

import argparse
import json
import os
import re
import sys
from pathlib import Path

DEFAULT_HUB_DIR = Path(os.environ.get("AG_HUB_DIR", "/home/sergiobermudez/local_projects/skills-hub")).resolve()

# ANSI Color codes for clean output
COLOR_RESET = "\033[0m"
COLOR_BOLD = "\033[1m"
COLOR_GREEN = "\033[32m"
COLOR_CYAN = "\033[36m"
COLOR_YELLOW = "\033[33m"
COLOR_RED = "\033[31m"
COLOR_DIM = "\033[2m"

def find_workspace_root() -> Path:
    """Finds the workspace root by walking up from cwd looking for .git or .agents."""
    curr = Path.cwd().resolve()
    for p in [curr] + list(curr.parents):
        if (p / ".git").exists() or (p / ".agents").exists():
            return p
    return curr

def get_skill_description(skill_dir: Path) -> str:
    """Extracts description from SKILL.md YAML frontmatter."""
    skill_file = skill_dir / "SKILL.md"
    if not skill_file.exists():
        return ""
    try:
        content = skill_file.read_text(encoding="utf-8", errors="replace")
        match = re.search(r"^---\s*\n(.*?)\n---", content, re.DOTALL)
        if match:
            fm = match.group(1)
            desc_match = re.search(r"description:\s*(?:>-|>|\|)?\s*(.+?)(?=\n[a-zA-Z_-]+:|\Z)", fm, re.DOTALL)
            if desc_match:
                desc = desc_match.group(1).replace("\n", " ").strip()
                desc = re.sub(r"\s+", " ", desc)
                return desc[:80] + ("..." if len(desc) > 80 else "")
    except Exception:
        pass
    return ""

def get_plugin_description(plugin_dir: Path) -> str:
    """Extracts description from plugin.json."""
    manifest = plugin_dir / "plugin.json"
    if not manifest.exists():
        return ""
    try:
        data = json.loads(manifest.read_text(encoding="utf-8"))
        desc = data.get("description", "")
        if desc:
            return desc[:80] + ("..." if len(desc) > 80 else "")
    except Exception:
        pass
    return ""

class HubManager:
    def __init__(self, hub_dir: Path = DEFAULT_HUB_DIR):
        self.hub_dir = hub_dir
        self.skills_dir = hub_dir / "skills"
        self.agents_cli_dir = hub_dir / "agents-cli"
        self.plugins_dir = hub_dir / "plugins"

    def get_available(self):
        """Returns dict of available customizations categorized by category."""
        available = {
            "skills": {},       # name -> {path, desc, category}
            "agents-cli": {},   # name -> {path, desc, category}
            "plugins": {}       # name -> {path, desc, category}
        }

        if self.skills_dir.exists():
            for d in sorted(self.skills_dir.iterdir()):
                if d.is_dir() and (d / "SKILL.md").exists():
                    available["skills"][d.name] = {
                        "path": d,
                        "desc": get_skill_description(d),
                        "category": "skill"
                    }

        if self.agents_cli_dir.exists():
            for d in sorted(self.agents_cli_dir.iterdir()):
                if (d.is_dir() or d.is_symlink()) and (d / "SKILL.md").exists():
                    available["agents-cli"][d.name] = {
                        "path": d,
                        "desc": get_skill_description(d),
                        "category": "agents-cli"
                    }

        if self.plugins_dir.exists():
            for d in sorted(self.plugins_dir.iterdir()):
                if d.is_dir() and (d / "plugin.json").exists():
                    available["plugins"][d.name] = {
                        "path": d,
                        "desc": get_plugin_description(d),
                        "category": "plugin"
                    }

        return available

    def get_workspace_active(self, workspace_root: Path):
        """Detects active skills and plugins in a workspace (manifests and symlinks)."""
        active_skills = {}   # name -> mode ("manifest" or "symlink")
        active_plugins = {}  # name -> mode

        agents_dir = workspace_root / ".agents"
        if not agents_dir.exists():
            return active_skills, active_plugins

        # 1. Check manifests
        skills_json_path = agents_dir / "skills.json"
        if skills_json_path.exists():
            try:
                data = json.loads(skills_json_path.read_text(encoding="utf-8"))
                for entry in data.get("entries", []):
                    entry_path = str(Path(entry.get("path", "")).resolve())
                    include_only = entry.get("include_only")
                    if include_only is not None:
                        for s in include_only:
                            active_skills[s] = "manifest"
                    else:
                        # Include all in that entry
                        ep = Path(entry_path)
                        if ep.exists():
                            for child in ep.iterdir():
                                if child.is_dir():
                                    active_skills[child.name] = "manifest"
            except Exception:
                pass

        plugins_json_path = agents_dir / "plugins.json"
        if plugins_json_path.exists():
            try:
                data = json.loads(plugins_json_path.read_text(encoding="utf-8"))
                for entry in data.get("entries", []):
                    entry_path = str(Path(entry.get("path", "")).resolve())
                    include_only = entry.get("include_only")
                    if include_only is not None:
                        for p in include_only:
                            active_plugins[p] = "manifest"
                    else:
                        ep = Path(entry_path)
                        if ep.exists():
                            for child in ep.iterdir():
                                if child.is_dir():
                                    active_plugins[child.name] = "manifest"
            except Exception:
                pass

        # 2. Check symlinks
        ws_skills = agents_dir / "skills"
        if ws_skills.exists():
            for child in ws_skills.iterdir():
                if child.is_symlink() or child.is_dir():
                    active_skills[child.name] = "symlink"

        ws_plugins = agents_dir / "plugins"
        if ws_plugins.exists():
            for child in ws_plugins.iterdir():
                if child.is_symlink() or child.is_dir():
                    active_plugins[child.name] = "symlink"

        return active_skills, active_plugins

    def enable(self, workspace_root: Path, names: list[str], as_symlink: bool = False):
        available = self.get_available()
        all_skills = {**available["skills"], **available["agents-cli"]}
        all_plugins = available["plugins"]

        agents_dir = workspace_root / ".agents"
        agents_dir.mkdir(parents=True, exist_ok=True)

        for name in names:
            if name in all_skills:
                item_info = all_skills[name]
                cat = item_info["category"]
                src_path = item_info["path"]
                parent_dir = self.skills_dir if cat == "skill" else self.agents_cli_dir

                if as_symlink:
                    target_dir = agents_dir / "skills"
                    target_dir.mkdir(parents=True, exist_ok=True)
                    link_path = target_dir / name
                    if link_path.exists() or link_path.is_symlink():
                        link_path.unlink()
                    link_path.symlink_to(src_path)
                    print(f"{COLOR_GREEN}✓{COLOR_RESET} Symlinked skill '{COLOR_BOLD}{name}{COLOR_RESET}' -> {link_path}")
                else:
                    # Update skills.json
                    self._update_manifest(agents_dir / "skills.json", parent_dir, name, add=True)
                    print(f"{COLOR_GREEN}✓{COLOR_RESET} Enabled skill '{COLOR_BOLD}{name}{COLOR_RESET}' in .agents/skills.json")

            elif name in all_plugins:
                item_info = all_plugins[name]
                src_path = item_info["path"]
                if as_symlink:
                    target_dir = agents_dir / "plugins"
                    target_dir.mkdir(parents=True, exist_ok=True)
                    link_path = target_dir / name
                    if link_path.exists() or link_path.is_symlink():
                        link_path.unlink()
                    link_path.symlink_to(src_path)
                    print(f"{COLOR_GREEN}✓{COLOR_RESET} Symlinked plugin '{COLOR_BOLD}{name}{COLOR_RESET}' -> {link_path}")
                else:
                    # Update plugins.json
                    self._update_manifest(agents_dir / "plugins.json", self.plugins_dir, name, add=True)
                    print(f"{COLOR_GREEN}✓{COLOR_RESET} Enabled plugin '{COLOR_BOLD}{name}{COLOR_RESET}' in .agents/plugins.json")

            else:
                print(f"{COLOR_RED}✗ Unknown skill or plugin:{COLOR_RESET} '{name}'")

    def disable(self, workspace_root: Path, names: list[str]):
        agents_dir = workspace_root / ".agents"
        if not agents_dir.exists():
            print(f"No .agents configuration found in {workspace_root}")
            return

        for name in names:
            removed = False
            # 1. Check manifests
            skills_json = agents_dir / "skills.json"
            if skills_json.exists():
                if self._update_manifest(skills_json, None, name, add=False):
                    print(f"{COLOR_YELLOW}Removed{COLOR_RESET} skill '{name}' from .agents/skills.json")
                    removed = True

            plugins_json = agents_dir / "plugins.json"
            if plugins_json.exists():
                if self._update_manifest(plugins_json, None, name, add=False):
                    print(f"{COLOR_YELLOW}Removed{COLOR_RESET} plugin '{name}' from .agents/plugins.json")
                    removed = True

            # 2. Check symlinks
            skill_symlink = agents_dir / "skills" / name
            if skill_symlink.exists() or skill_symlink.is_symlink():
                skill_symlink.unlink()
                print(f"{COLOR_YELLOW}Removed{COLOR_RESET} symlink {skill_symlink}")
                removed = True

            plugin_symlink = agents_dir / "plugins" / name
            if plugin_symlink.exists() or plugin_symlink.is_symlink():
                plugin_symlink.unlink()
                print(f"{COLOR_YELLOW}Removed{COLOR_RESET} symlink {plugin_symlink}")
                removed = True

            if not removed:
                print(f"{COLOR_DIM}Item '{name}' was not active in this workspace.{COLOR_RESET}")

    def _update_manifest(self, manifest_file: Path, parent_dir: Path | None, item_name: str, add: bool = True) -> bool:
        """Updates or removes items in skills.json or plugins.json."""
        data = {"entries": []}
        if manifest_file.exists():
            try:
                data = json.loads(manifest_file.read_text(encoding="utf-8"))
            except Exception:
                data = {"entries": []}

        entries = data.get("entries", [])
        modified = False

        if add and parent_dir is not None:
            resolved_parent = str(parent_dir.resolve())
            entry_match = None
            for e in entries:
                if str(Path(e.get("path", "")).resolve()) == resolved_parent:
                    entry_match = e
                    break

            if entry_match:
                inc = entry_match.setdefault("include_only", [])
                if item_name not in inc:
                    inc.append(item_name)
                    inc.sort()
                    modified = True
            else:
                entries.append({
                    "path": str(parent_dir.resolve()),
                    "include_only": [item_name]
                })
                modified = True
            data["entries"] = entries

        elif not add:
            new_entries = []
            for e in entries:
                inc = e.get("include_only")
                if inc is not None and item_name in inc:
                    inc.remove(item_name)
                    modified = True
                if inc is None or len(inc) > 0:
                    new_entries.append(e)
            data["entries"] = new_entries

        if modified:
            if not data["entries"]:
                # If no entries left, remove manifest file
                if manifest_file.exists():
                    manifest_file.unlink()
            else:
                manifest_file.parent.mkdir(parents=True, exist_ok=True)
                manifest_file.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
        return modified

    def scaffold(self, item_type: str, name: str):
        if item_type == "skill":
            target = self.skills_dir / name
            if target.exists():
                print(f"{COLOR_RED}Error:{COLOR_RESET} Skill '{name}' already exists at {target}")
                return
            target.mkdir(parents=True, exist_ok=True)
            skill_md = target / "SKILL.md"
            skill_md.write_text(f"""---
name: {name}
description: Describe what {name} does and when the agent should activate it.
---

# {name.replace('-', ' ').title()}

## When to Use This Skill
- 

## Workflow
1. 
""", encoding="utf-8")
            print(f"{COLOR_GREEN}✓{COLOR_RESET} Created new skill '{COLOR_BOLD}{name}{COLOR_RESET}' at {target}")

        elif item_type == "plugin":
            target = self.plugins_dir / name
            if target.exists():
                print(f"{COLOR_RED}Error:{COLOR_RESET} Plugin '{name}' already exists at {target}")
                return
            (target / "skills").mkdir(parents=True, exist_ok=True)
            (target / "rules").mkdir(parents=True, exist_ok=True)
            manifest = target / "plugin.json"
            manifest.write_text(json.dumps({
                "name": name,
                "description": f"Description for {name}"
            }, indent=2) + "\n", encoding="utf-8")
            print(f"{COLOR_GREEN}✓{COLOR_RESET} Created new plugin '{COLOR_BOLD}{name}{COLOR_RESET}' at {target}")


def cmd_list(manager: HubManager, workspace_root: Path):
    available = manager.get_available()
    active_skills, active_plugins = manager.get_workspace_active(workspace_root)

    print(f"\n{COLOR_BOLD}Antigravity Hub:{COLOR_RESET} {manager.hub_dir}")
    print(f"{COLOR_BOLD}Current Workspace:{COLOR_RESET} {workspace_root}\n")

    def print_section(title, items, active_dict):
        print(f"{COLOR_CYAN}{COLOR_BOLD}=== {title} ==={COLOR_RESET}")
        if not items:
            print(f"  {COLOR_DIM}(none){COLOR_RESET}")
            return
        for name, info in sorted(items.items()):
            active_mode = active_dict.get(name)
            if active_mode:
                badge = f"{COLOR_GREEN}[ACTIVE ({active_mode})]{COLOR_RESET}"
            else:
                badge = f"{COLOR_DIM}[              ]{COLOR_RESET}"
            desc = f" - {COLOR_DIM}{info['desc']}{COLOR_RESET}" if info['desc'] else ""
            print(f"  {badge} {COLOR_BOLD}{name:<32}{COLOR_RESET}{desc}")
        print()

    print_section("Custom Skills (skills/)", available["skills"], active_skills)
    print_section("Google Agents CLI Suite (agents-cli/)", available["agents-cli"], active_skills)
    print_section("Bundled Plugins (plugins/)", available["plugins"], active_plugins)


def cmd_status(manager: HubManager, workspace_root: Path):
    active_skills, active_plugins = manager.get_workspace_active(workspace_root)
    print(f"\n{COLOR_BOLD}Workspace:{COLOR_RESET} {workspace_root}")
    print(f"{COLOR_BOLD}Hub Directory:{COLOR_RESET} {manager.hub_dir}\n")

    if not active_skills and not active_plugins:
        print(f"{COLOR_YELLOW}No skills or plugins currently activated in this workspace.{COLOR_RESET}")
        print(f"Run {COLOR_BOLD}ag-hub list{COLOR_RESET} or {COLOR_BOLD}ag-hub enable <name>{COLOR_RESET} to activate customizations.\n")
        return

    print(f"{COLOR_CYAN}{COLOR_BOLD}Active Skills:{COLOR_RESET}")
    for s, mode in sorted(active_skills.items()):
        print(f"  {COLOR_GREEN}✓{COLOR_RESET} {s} {COLOR_DIM}(via {mode}){COLOR_RESET}")

    if active_plugins:
        print(f"\n{COLOR_CYAN}{COLOR_BOLD}Active Plugins:{COLOR_RESET}")
        for p, mode in sorted(active_plugins.items()):
            print(f"  {COLOR_GREEN}✓{COLOR_RESET} {p} {COLOR_DIM}(via {mode}){COLOR_RESET}")
    print()


def cmd_interactive(manager: HubManager, workspace_root: Path):
    available = manager.get_available()
    active_skills, active_plugins = manager.get_workspace_active(workspace_root)

    items = []
    # Gather all items
    for name, info in sorted({**available["skills"], **available["agents-cli"]}.items()):
        items.append((name, "skill", active_skills.get(name) is not None, info["desc"]))
    for name, info in sorted(available["plugins"].items()):
        items.append((name, "plugin", active_plugins.get(name) is not None, info["desc"]))

    if not items:
        print("No skills or plugins found in hub.")
        return

    selected = {name: is_active for name, _, is_active, _ in items}

    print(f"\n{COLOR_BOLD}Interactive Customization Selector{COLOR_RESET}")
    print(f"Workspace: {workspace_root}\n")
    print("Toggle items by entering their numbers separated by spaces (e.g. '1 3 5').")
    print("Type 'save' to apply changes, or 'q' to quit without saving.\n")

    while True:
        print("-" * 70)
        for i, (name, itype, _, desc) in enumerate(items, 1):
            box = f"{COLOR_GREEN}[x]{COLOR_RESET}" if selected[name] else "[ ]"
            type_tag = f"{COLOR_CYAN}[{itype}]{COLOR_RESET}"
            print(f"  {i:>2}. {box} {type_tag} {COLOR_BOLD}{name:<30}{COLOR_RESET} {COLOR_DIM}{desc[:40]}{COLOR_RESET}")
        print("-" * 70)

        choice = input(f"{COLOR_BOLD}Enter numbers to toggle, 'save', or 'q': {COLOR_RESET}").strip().lower()
        if choice in ('q', 'quit', 'exit'):
            print("Aborted without changes.")
            return
        if choice in ('save', 's', 'done'):
            break

        parts = choice.replace(',', ' ').split()
        for p in parts:
            if p.isdigit():
                idx = int(p) - 1
                if 0 <= idx < len(items):
                    item_name = items[idx][0]
                    selected[item_name] = not selected[item_name]
                    print(f"Toggled '{item_name}' -> {'ON' if selected[item_name] else 'OFF'}")

    # Apply diff
    to_enable = [name for name, is_sel in selected.items() if is_sel and not (active_skills.get(name) or active_plugins.get(name))]
    to_disable = [name for name, is_sel in selected.items() if not is_sel and (active_skills.get(name) or active_plugins.get(name))]

    if to_enable:
        manager.enable(workspace_root, to_enable)
    if to_disable:
        manager.disable(workspace_root, to_disable)

    print(f"\n{COLOR_GREEN}{COLOR_BOLD}Workspace configuration updated successfully!{COLOR_RESET}\n")


def main():
    parser = argparse.ArgumentParser(
        prog="ag-hub",
        description="Zero-copy Antigravity Customizations Manager"
    )
    parser.add_argument("--hub", type=Path, default=DEFAULT_HUB_DIR, help=f"Path to skills hub (default: {DEFAULT_HUB_DIR})")
    parser.add_argument("--workspace", "-w", type=Path, default=None, help="Target workspace root (default: current workspace)")

    subparsers = parser.add_subparsers(dest="command", help="Subcommand to run")

    # list
    p_list = subparsers.add_parser("list", aliases=["ls"], help="List available skills and plugins")

    # status
    p_status = subparsers.add_parser("status", help="Show active customizations in current workspace")

    # enable
    p_enable = subparsers.add_parser("enable", aliases=["add"], help="Enable skills or plugins in workspace")
    p_enable.add_argument("names", nargs="+", help="Names of skills or plugins to enable")
    p_enable.add_argument("--symlink", "-s", action="store_true", help="Use symlinks instead of .agents/skills.json manifest")

    # disable
    p_disable = subparsers.add_parser("disable", aliases=["rm"], help="Disable skills or plugins in workspace")
    p_disable.add_argument("names", nargs="+", help="Names of skills or plugins to disable")

    # select / interactive
    p_select = subparsers.add_parser("select", aliases=["interactive", "-i"], help="Interactive checklist to select active skills")

    # create
    p_create = subparsers.add_parser("create", help="Create a new skill or plugin in the hub")
    p_create.add_argument("type", choices=["skill", "plugin"], help="Type to create")
    p_create.add_argument("name", help="Name of the skill or plugin")

    args = parser.parse_args()

    manager = HubManager(hub_dir=args.hub)
    workspace_root = args.workspace.resolve() if args.workspace else find_workspace_root()

    if args.command in ("list", "ls") or args.command is None:
        cmd_list(manager, workspace_root)
    elif args.command == "status":
        cmd_status(manager, workspace_root)
    elif args.command in ("enable", "add"):
        manager.enable(workspace_root, args.names, as_symlink=args.symlink)
    elif args.command in ("disable", "rm"):
        manager.disable(workspace_root, args.names)
    elif args.command in ("select", "interactive", "-i"):
        cmd_interactive(manager, workspace_root)
    elif args.command == "create":
        manager.scaffold(args.type, args.name)
    else:
        parser.print_help()

if __name__ == "__main__":
    main()
